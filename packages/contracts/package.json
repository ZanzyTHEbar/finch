    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.14.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
