{
  "name": "@finch/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./callback": "./src/gen/finch/v1/callback_pb.ts"
  },
  "scripts": {
    "generate": "buf generate",
    "generate:check": "buf generate && git -C ../.. diff --exit-code -- packages/contracts/src/gen",
